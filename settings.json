{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "outputStyle": "Spartan",
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable",
        "sparsePaths": [".claude-plugin", "plugin"]
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag",
        "sparsePaths": [".claude-plugin", "skills"]
      }
    }
  },
  "enabledPlugins": {
    "brag@brag": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phase6-consolidate.sh\"",
            "timeout": 15,
            "statusMessage": "Checking alta-dev Phase 6 (reinforcement loop)"
          }
        ]
      }
    ]
  }
}
