{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "outputStyle": "Spartan",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable",
        "sparsePaths": [
          ".claude-plugin",
          "plugin"
        ]
      }
    },
    "heydamir": {
      "source": {
        "source": "github",
        "repo": "heydamir/unslop",
        "sparsePaths": [
          ".claude-plugin",
          "skills"
        ]
      }
    },
    "arena-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/arena-skill",
        "sparsePaths": [
          ".claude-plugin",
          "skills"
        ]
      }
    }
  },
  "enabledPlugins": {
    "unslop@heydamir": true,
    "arena-skill@arena-skill": true,
    "code-modernization@claude-plugins-official": true
  },
  "skillOverrides": {
    "arena-skill:arena": "user-invocable-only",
    "handoff": "user-invocable-only"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phase6-consolidate.sh\"",
            "timeout": 15,
            "statusMessage": "Checking alta-dev Phase 6 (reinforcement loop)"
          }
        ]
      }
    ]
  }
}
