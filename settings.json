{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "outputStyle": "Spartan",
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable",
        "sparsePaths": [".claude-plugin", "plugin"]
      }
    },
    "heydamir": {
      "source": {
        "source": "github",
        "repo": "heydamir/unslop",
        "sparsePaths": [".claude-plugin", "skills"]
      }
    },
    "arena-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/arena-skill",
        "sparsePaths": [".claude-plugin", "skills"]
      }
    }
  },
  "enabledPlugins": {
    "unslop@heydamir": true,
    "arena-skill@arena-skill": true,
    "code-modernization@claude-plugins-official": true
  },
  "skillOverrides": {
    "arena-skill:arena": "user-invocable-only",
    "caveman": "off",
    "write-a-skill": "off",
    "tdd": "user-invocable-only",
    "diagnose": "user-invocable-only",
    "handoff": "user-invocable-only",
    "teach": "user-invocable-only",
    "zoom-out": "user-invocable-only",
    "prototype": "user-invocable-only",
    "grill-with-docs": "user-invocable-only",
    "to-prd": "user-invocable-only",
    "to-issues": "user-invocable-only",
    "triage": "user-invocable-only",
    "setup-matt-pocock-skills": "name-only"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phase6-consolidate.sh\"",
            "timeout": 15,
            "statusMessage": "Checking alta-dev Phase 6 (reinforcement loop)"
          }
        ]
      }
    ]
  }
}
